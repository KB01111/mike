PORT=3001
FRONTEND_URL=http://localhost:3000

# HMAC key used to sign /download/:token URLs. Required at startup.
# Generate with: openssl rand -hex 32
DOWNLOAD_SIGNING_SECRET=replace-with-a-random-32-byte-hex-string

# HMAC key used to sign local auth sessions.
AUTH_JWT_SECRET=replace-with-a-random-32-byte-hex-string
# Optional extra secret mixed into password hashes.
PASSWORD_PEPPER=

R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=mike
# Optional physical prefix for new/migrated objects while DB storage_path values
# stay logical, e.g. document_versions.storage_path = documents/.../source.pdf.
R2_KEY_PREFIX=mike-v2

GEMINI_API_KEY=your-gemini-key
ANTHROPIC_API_KEY=your-anthropic-key
OPENAI_API_KEY=your-openai-key
RESEND_API_KEY=your-resend-key
USER_API_KEYS_ENCRYPTION_SECRET=your-long-random-secret

# One-off migration inputs. These are not used by the runtime server.
DATABASE_URL=postgres://user:password@localhost:5432/mike
MIGRATION_SUPABASE_URL=https://your-project.supabase.co
MIGRATION_SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Leave unset to reuse the destination R2 credentials above for source reads.
MIGRATION_R2_SOURCE_ENDPOINT_URL=
MIGRATION_R2_SOURCE_ACCESS_KEY_ID=
MIGRATION_R2_SOURCE_SECRET_ACCESS_KEY=
MIGRATION_R2_SOURCE_BUCKET_NAME=mike
MIGRATION_REPORT_PATH=migration-report.json
